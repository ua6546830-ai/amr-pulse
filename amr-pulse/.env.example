# ── AI provider (server-side only) ───────────────────────────────────────────
# Leave these unset to run in deterministic mode. The assistant still works and
# composes answers from read-only analysis tools; no key ever reaches the browser.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_REQUESTS_PER_HOUR=30

# ── Public site URL (used for canonical links, Open Graph and sitemap) ────────
# Example: https://amr-pulse.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Optional Supabase research workspace (Mode B) ────────────────────────────
# Mode A (the public demo) works with none of these variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=
