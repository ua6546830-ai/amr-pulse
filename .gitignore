# Dependencies and build output
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Environment files — never commit real secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!**/.env.example

# Vercel / local deployment state
.vercel/
.vercelignore

# Test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local scratch and logs
.scratch/
*.log
logs/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Large raw research extracts are reproducible from the committed fetch scripts.
# The 195 MB BV-BRC extracts are intentionally excluded from Git; see AMR-PULSE-RESEARCH/README.md.
AMR-PULSE-RESEARCH/raw_data/*
!AMR-PULSE-RESEARCH/raw_data/extraction_manifest.json

# Python bytecode from optional analysis scripts
__pycache__/
*.pyc
